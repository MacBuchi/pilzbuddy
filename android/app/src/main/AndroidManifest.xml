<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- flutter_foreground_task deklariert das für autoRunOnBoot; wir starten
         nie beim Booten (autoRunOnBoot bleibt false). Nicht deklarierte
         Berechtigungen muss man bei der Play-Prüfung auch nicht erklären. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"
        tools:node="remove"/>
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>
    <!-- Karten-Download: hält den Prozess wach, solange geladen wird.
         Ohne Foreground-Service friert Android den Prozess beim
         App-Wechsel ein und der Download steht still. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC"/>
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <!-- Update der GitHub-APK in der App laden und dem System-Installer
         übergeben (Issue #88 hatte das entfernt, #161 baut es ohne
         `ota_update` neu auf). Bewusst NUR diese eine: INSTALL_PACKAGES
         (Signatur-Berechtigung) und READ/WRITE_EXTERNAL_STORAGE brachte
         allein das Manifest jenes Pakets mit.

         ACHTUNG Play: Selbst-Updates verstoßen gegen „Device and Network
         Abuse". Der Update-Pfad ist im Play-Build über
         AppDistribution.showsUpdateHints komplett aus, diese Zeile bliebe im
         AAB aber stehen. Vor einer Play-Einreichung muss sie raus — per
         Produkt-Flavor mit eigenem Manifest. Siehe docs/play-console.md. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES"/>
    <application
        android:label="PilzBuddy"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:fullBackupContent="@xml/full_backup_content"
        android:dataExtractionRules="@xml/backup_rules">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Foreground-Service für den Karten-Download (flutter_foreground_task).
             Der Klassenname stammt aus dem Paket und darf nicht geändert werden. -->
        <service
            android:name="com.pravera.flutter_foreground_task.service.ForegroundService"
            android:foregroundServiceType="dataSync"
            android:exported="false"/>
        <!-- Reicht die geladene APK an den System-Installer heraus. Ab
             Android 7 ist eine `file://`-URI dafür verboten; der Installer
             läuft in einem fremden Prozess und bekommt die Datei über eine
             content-URI mit erteilter Leseerlaubnis.
             `exported="false"`: Nur wer die Erlaubnis erteilt bekommt, darf
             lesen — die Datei ist nicht für Dritte offen. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"/>
        </provider>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- url_launcher: APK-Download des Updates im Browser öffnen -->
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="https"/>
        </intent>
    </queries>
</manifest>
