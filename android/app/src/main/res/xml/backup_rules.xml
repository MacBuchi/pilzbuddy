<?xml version="1.0" encoding="utf-8"?>
<!--
  Backup-Regeln ab Android 12 (API 31). Gesichert wird weiter, aber ohne:

  * FlutterSharedPreferences.xml — darin liegt ausschließlich der
    Supabase-Session-Token (`flutter.sb-<projekt>-auth-token`). Ein
    Auth-Credential hat weder in der Google-Cloud noch auf einem anderen
    Gerät etwas verloren. Seit #145 liegt in derselben Datei die gemerkte
    Kartenquelle (online/offline) — ein Gerätewechsel setzt sie also auf
    Online zurück. Das ist der richtige Tausch: Der Token wiegt schwerer,
    und ohne heruntergeladene Regionskarte (die ebenfalls nicht mitkommt)
    wäre eine gemerkte Offline-Karte auf dem neuen Gerät ohnehin leer.
  * updates/ — die geladene Update-APK (~60 MB). Reiner Zwischenschritt,
    beim nächsten Update ohnehin neu geladen.
  * offline_maps/ — die Bundesland-PMTiles sind 44 MB bis 1,7 GB groß und
    jederzeit neu ladbar. Auto-Backup hat ein Kontingent von 25 MB pro App;
    eine einzige Regionskarte sprengt es und lässt das Backup scheitern.
    Die Registry liegt im selben Ordner — `listInstalled()` überspringt
    Einträge ohne Datei, ein Teil-Restore ist also unkritisch.
  * spot_cache/ — die zwischengespeicherten eigenen Spots. Das sind die
    geheimen Fundstellen samt Koordinaten; Googles Cloud-Backup ist in der
    Datenschutzerklärung kein Empfänger und soll auch keiner werden. Die
    Daten liegen ohnehin in Supabase und sind nach dem ersten Abruf auf
    dem neuen Gerät wieder da.
  * outbox/ — die Aufträge des Ausgangskorbs (#267): Funde, die ohne
    Empfang entstanden sind und noch auf die Übertragung warten. Dieselbe
    Begründung wie bei spot_cache/, nur schärfer — hier stehen die
    Koordinaten, BEVOR sie irgendwo anders stehen.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="FlutterSharedPreferences.xml"/>
        <exclude domain="file" path="offline_maps"/>
        <exclude domain="file" path="outbox"/>
        <exclude domain="file" path="spot_cache"/>
        <exclude domain="file" path="tours"/>
        <exclude domain="file" path="updates"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="FlutterSharedPreferences.xml"/>
        <exclude domain="file" path="offline_maps"/>
        <exclude domain="file" path="outbox"/>
        <exclude domain="file" path="spot_cache"/>
        <exclude domain="file" path="tours"/>
        <exclude domain="file" path="updates"/>
    </device-transfer>
</data-extraction-rules>
