{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/tool/session_status.py\"",
            "timeout": 20
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(flutter test *)",
      "Bash(flutter analyze *)",
      "Bash(git fetch origin)",
      "Bash(python3 tool/session_status.py)",
      "Bash(python3 tool/agent_docs.py)",
      "mcp__claude_ai_Supabase__list_projects",
      "mcp__claude_ai_Supabase__get_project",
      "mcp__claude_ai_Supabase__list_tables",
      "mcp__claude_ai_Supabase__list_migrations",
      "mcp__claude_ai_Supabase__list_organizations",
      "mcp__claude_ai_Supabase__get_advisors",
      "mcp__plugin_firebase_firebase__firebase_get_environment",
      "mcp__plugin_firebase_firebase__firebase_list_projects"
    ]
  }
}
